  "agents": {
    "orchestrator": [
      "ade_status",
      "ade_doctor",
      "ade_workflow_start",
      "ade_workflow_run",
      "ade_workflow_snapshot",
      "ade_workflow_cancel",
      "ade_kernel_reconcile",
      "ade_kernel_events",
      "ade_worker_events",
      "ade_tracker_project_snapshot"
    ],
    "explorer": [],
    "implementer": [
      "ade_vcs_status",
      "ade_vcs_diff",
      "ade_self_check"
    ],
    "verifier": [
      "ade_vcs_status",
      "ade_vcs_diff"
    ],
    "reviewer": [
      "ade_vcs_status",
      "ade_vcs_diff"
    ]
  },
  "hide_core_tools": {
    "orchestrator": [
      "shell",
      "execute",
      "edit",
      "subagent",
      "skill"
    ],
    "explorer": [
      "shell",
      "execute",
      "edit",
      "subagent",
      "skill"
    ],
    "implementer": [
      "shell",
      "execute",
      "subagent",
      "skill"
    ],
    "verifier": [
      "shell",
      "execute",
      "edit",
      "subagent",
      "skill"
    ],
    "reviewer": [
      "shell",
      "execute",
      "edit",
      "subagent",
      "skill"
    ]
  },
  "generation_max_tokens": {
    "orchestrator": 1200,
    "explorer": 1200,
    "implementer": 1600,
    "verifier": 1200,
    "reviewer": 1000
  },
  "handoff_contract": {
    "statuses": [
      "DONE",
      "PARTIAL",
      "BLOCKED",
      "FAILED"
    ],
    "max_handoff_bytes": 4096,
    "max_changed_items": 8,
    "max_evidence_refs": 8,
    "max_changed_chars": 180,
    "max_evidence_ref_chars": 240,
    "max_blocker_chars": 800,
    "max_next_chars": 500,
    "recent_in_control": 3,
    "runtime_generated_for": [
      "tracker.project.sync"
    ]
  },
  "deterministic_control_plane": {
    "architecture": "DURABLE_OBSERVABLE_RUNTIME",
    "canonical_state": "external_hash_chained_event_journal",
    "snapshot": "derived_cache",
    "scheduler": "kernel_only",
    "worker_delegation": "forbidden",
    "worker_sessions": "session.create/switchAgent/prompt/wait/context + event.subscribe observation",
    "job_lease_ms": 300000,
    "job_max_attempts": 2,
    "mutating_worker_concurrency_per_project": 1,
    "legacy_plane_tools": "registered_but_unexposed",
    "tracker_primary": [
      "ade_tracker_project_snapshot",
      "tracker_sync workflow"
    ],
    "same_failure_signature_retry_max": 1,
    "tool_choice_auto_only_retry": 0,
    "observation_plane": "non_canonical_event_stream_with_heartbeat_fallback",
    "host_baseline": "opencode2-0.0.0-beta-18743",
    "workspace_observation": "git when valid; bounded external filesystem baseline/diff when no repository is present",
    "git_requirement": "optional only for NO_REPOSITORY/VCS_UNAVAILABLE; inconsistent/nested VCS fails closed"
  },
  "hardening": {
    "project_state_realpath_boundary": true,
    "jsonl_symlink_rejection": true,
    "bounded_rotating_logs": true,
    "model_output_redaction": true,
    "minimal_child_environment": true,
    "docker_network_default": "none",
    "docker_read_only_rootfs": true,
    "docker_drop_all_capabilities": true,
    "git_hooks_bypass_default": false,
    "git_signing_preserved": true,
    "staged_secret_scan": true,
    "remote_http_redirects": "blocked",
    "jira_host_allowlist": "human-owned tracker policy",
    "session_identifiers": "sha256-prefix pseudonymized",
    "installer_jsonc_comment_preservation": "fail-closed",
    "backup_retention": 10,
    "managed_delegation_runtime": false,
    "complete_context_rehydration_guard": true,
    "required_child_runtime_enforcement": true,
    "raw_subagent_blocked": true,
    "durable_kernel": true,
    "worker_to_worker_delegation": "denied",
    "canonical_state_outside_repo": true,
    "hash_chained_event_journal": true,
    "project_mutation_lease": true
  },
  "provider_compat": {
    "auto_only_tool_choice_models": [
      "muse-spark-1.2-contributor-free",
      "mimo-v2.5-free",
      "hy3-free",
      "ling-3.0-flash-fin-free",
      "nemotron-3-ultra-free",
      "nemotron-3.5-lightning-free"
    ],
    "policy": "required_or_named_to_auto; none_to_tools_omitted",
    "scope": "known OpenCode Zen free models only"
  },
  "durable_kernel": {
    "schema_version": 1,
    "runtime": "file_backed_event_sourcing",
    "event_hash_chain": "sha256",
    "project_state_location": "user_state_outside_repository",
    "workflow_kinds": [
      "analysis",
      "engineering",
      "implementation_proposal",
      "tracker_sync"
    ],
    "worker_roles": {
      "ANALYST": "explorer",
      "BUILDER": "implementer",
      "VERIFIER": "verifier",
      "REVIEWER": "reviewer"
    },
    "engineering_requires_deterministic_check": true,
    "crash_recovery": "lease_expiry_reconcile",
    "safe_mode_on_corruption": true,
    "effect_authorization": "exact-effect external grants",
    "preflight_vcs": "engineering admission validates git toplevel and HEAD before worker creation"
  },
  "observation_plane": {
    "schema_version": 1,
    "canonical": false,
    "source": "ctx.event.subscribe",
    "fallback": "session.get/session.context polling + heartbeat",
    "journal": "observations.jsonl",
    "rotation_bytes": 12582912,
    "live_projection": "Task-compatible tool metadata (title + metadata.sessionId + metadata.summary) with parent-linked worker session",
    "worker_registry": "in-memory raw sessionID mapping; raw child ID is emitted only into host tool metadata for native navigation; ADE model-facing refs are sha256 prefixes",
    "event_policy": "events explain runs but never mutate canonical workflow state",
    "host_event_aliases": [
      "message.part.updated",
      "message.updated",
      "session.status",
      "session.text.delta",
      "session.reasoning.delta",
      "session.tool.called",
      "session.tool.success",
      "session.tool.failed",
      "session.execution.succeeded",
      "session.execution.failed"
    ],
    "reasoning_payload_projection": false,
    "completed_worker_inspection": "parent-bound /ade-worker command with redaction",
    "capture_semantics": "EVENT_NATIVE means host event ingestion only; TUI visibility requires target-host canary",
    "child_session_link": "session.create(parentID=<orchestrator session>)"
  }
}
