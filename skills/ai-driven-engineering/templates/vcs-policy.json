{
  "schema_version": 1,
  "authorized": false,
  "policy_owner": "human",
  "protected_branches": [
    "main",
    "master"
  ],
  "stage": {
    "allowed": true
  },
  "commit": {
    "allowed": true,
    "allow_protected_branches": false
  },
  "push": {
    "allowed": true,
    "remote": "origin",
    "allow_protected_branches": false,
    "force": false
  },
  "pull_request": {
    "allowed": true,
    "base_branch": "main"
  }
}
