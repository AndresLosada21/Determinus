{
  "schema_version": 1,
  "authorized": false,
  "policy_owner": "human",
  "cross_workspace_git_metadata": true,
  "checks": {},
  "hardening_defaults": {
    "process_environment": "minimal; opt-in allowlist per check",
    "docker_network": "none unless allow_network=true",
    "docker_rootfs": "read-only",
    "docker_capabilities": "drop ALL",
    "docker_no_new_privileges": true,
    "docker_image": "sha256 digest required unless allow_mutable_image=true",
    "host_process": "runner=process is explicit opt-in; allow_host_process=false explicitly vetoes; exact-effect human grant remains mandatory"
  }
}
